# MyDimension — environment variables (EXAMPLE ONLY — placeholders, never real secrets)
# Copy this file to .env for local development, or set these variables in
# Vercel Project Settings for deployment. Never commit a real .env file.

# The ONLY Gmail address allowed to sign in (verified by Google OAuth).
# Confirmed by the owner on 25 Nov 2026: technicalmahmudull@gmail.com
# The same Google account is used for login, Drive, and Gemini setup,
# but each is a separate permission/consent.
ADMIN_EMAIL=technicalmahmudull@gmail.com

# User ID for password sign-in (optional). Defaults to the part of
# ADMIN_EMAIL before "@" (technicalmahmudull). The password itself is
# NOT stored here — it is set from Settings and stored only as a
# PBKDF2 hash in the database.
ADMIN_USERNAME=technicalmahmudull

# Managed PostgreSQL connection string (Neon preferred).
# Get it from Neon Console > Connect, or from the Vercel Marketplace Neon integration.
# Example format only: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/mydimension?sslmode=require

# Google Gemini API key (from Google AI Studio). Backend only, never in frontend code.
GEMINI_API_KEY=put_your_gemini_key_here

# Google OAuth (web application) credentials for sign-in + Drive access.
# Create them in Google Cloud Console. Values are placeholders only.
GOOGLE_CLIENT_ID=put_your_google_client_id_here
GOOGLE_CLIENT_SECRET=put_your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Random secret for signing session cookies. Generate a long random value.
SESSION_SECRET=put_a_long_random_session_secret_here

# Where the frontend is served from (used for CORS). Change for production.
FRONTEND_ORIGIN=http://localhost:8000

# Gemini model name — change in one place if Google updates model names.
GEMINI_MODEL=gemini-2.0-flash
